; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Project Chimera"
config/description="Isometric dorm simulation with 6 autonomous NPCs"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Scheduler="*res://autoload/scheduler.gd"
Difficulty="*res://autoload/difficulty.gd"
LocalMemory="*res://autoload/local_memory.gd"
Investigation="*res://autoload/investigation.gd"
Standing="*res://autoload/standing.gd"
CaseFile="*res://autoload/case_file.gd"
GameFlow="*res://autoload/game_flow.gd"
Consequences="*res://autoload/consequences.gd"
LocationManager="*res://autoload/location_manager.gd"
EventLog="*res://autoload/event_log.gd"
MusicManager="*res://autoload/music_manager.gd"
EventBus="*res://addons/event_bus/event_bus.gd"
AIClient="*res://autoload/ai_client.gd"
ModelDownload="*res://autoload/model_download.gd"
LocalAI="*res://autoload/local_ai.gd"
DialogSystem="*res://addons/dialog_system/dialog_system.gd"
SaveManager="*res://addons/locker/save_manager.gd"
Notebook="*res://autoload/notebook.gd"
Tutorial="*res://autoload/tutorial.gd"
NPCRelationships="*res://autoload/npc_relationships.gd"
Effects="*res://autoload/effects.gd"
SFXHelper="*res://scripts/audio/sfx_helper.gd"
EvidenceQuality="*res://autoload/evidence_quality.gd"
ScheduledEvents="*res://autoload/scheduled_events.gd"
MCPBridge="*res://autoload/mcp_bridge.gd"
MCPRuntimeBridge="*res://addons/godot_mcp/services/mcp_runtime_bridge.gd"
MCPInputBridge="*res://addons/godot_mcp/services/mcp_input_bridge.gd"
MCPScreenshotBridge="*res://addons/godot_mcp/services/mcp_screenshot_bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Project Chimera"

[echo]

nobodywho_model_path="res://models/Llama-3.2-1B-Instruct-Q4_K_M.gguf"

[editor_plugins]

enabled=PackedStringArray("res://addons/beehave/plugin.cfg", "res://addons/dialog_system/plugin.cfg", "res://addons/event_bus/plugin.cfg", "res://addons/godot_mcp/plugin.cfg", "res://addons/locker/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://resources/theme/detective_theme.tres"

